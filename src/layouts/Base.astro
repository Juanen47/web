---
import '../styles/fonts.css';
import '../styles/global.css';
import { SITE, routes, ui, type Lang, type RouteKey } from '../i18n/content';

interface Props {
  lang: Lang;
  route: RouteKey | null;
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const { lang, route, title, description, noindex = false, jsonLd } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'es' ? 'en' : 'es';
const canonical = route ? new URL(routes[route][lang], SITE.url).href : null;
const ogImage = new URL('/og.png', SITE.url).href;
const homeHref = routes.home[lang];
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content={SITE.name} />
  {noindex && <meta name="robots" content="noindex" />}
  {canonical && <link rel="canonical" href={canonical} />}
  {route && (
    <>
      <link rel="alternate" hreflang="es" href={new URL(routes[route].es, SITE.url).href} />
      <link rel="alternate" hreflang="en" href={new URL(routes[route].en, SITE.url).href} />
      <link rel="alternate" hreflang="x-default" href={new URL(routes[route].es, SITE.url).href} />
    </>
  )}
  <meta name="color-scheme" content="light dark" />
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f3f5f8" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0d1420" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="jelopez.link" />
  <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />

  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body>
  <a href="#main" class="skip-link">{t.skip}</a>

  <nav class="site-nav" aria-label={lang === 'es' ? 'Principal' : 'Main'}>
    <div class="wrap">
      <a href={homeHref} class="brand">jelopez<span class="dot">.</span>link</a>
      <ul class="nav-links">
        <slot name="nav" />
      </ul>
      {route && (
        <a href={routes[route][other]} hreflang={other} lang={other} class="lang-switch" aria-label={t.switchLabel} title={t.switchLabel}>{t.switchText}</a>
      )}
    </div>
  </nav>

  <main id="main">
    <slot />
  </main>

  <footer>
    <div class="wrap">
      <p>© {new Date().getFullYear()} {SITE.name}</p>
      <ul class="footer-links">
        <li><a href={SITE.github} rel="me noopener">GitHub</a></li>
        <li><a href={SITE.linkedin} rel="me noopener">LinkedIn</a></li>
        <li><a href={SITE.blog}>Blog</a></li>
        <li><a href={`mailto:${SITE.email}`}>Email</a></li>
        <li><a href={routes.site[lang]}>{t.footer.site}</a></li>
        <li><a href={routes.privacy[lang]}>{t.footer.privacy}</a></li>
      </ul>
    </div>
  </footer>
</body>
</html>
