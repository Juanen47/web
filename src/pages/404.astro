---
import Base from '../layouts/Base.astro';
---

<Base lang="es" route={null} title="Página no encontrada · jelopez.link" description="Esta página no existe." noindex>
  <header class="hero">
    <p class="hero-tag">ERROR 404</p>
    <h1>404<span class="accent">.</span></h1>
    <p class="hero-sub">Esta página no existe o se ha movido. <span lang="en">This page doesn't exist or has moved.</span></p>
    <div class="hero-buttons">
      <a href="/" class="btn btn-primary">Ir al inicio</a>
      <a href="/en/" class="btn btn-outline" lang="en">Go home</a>
    </div>
  </header>
</Base>
