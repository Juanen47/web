---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Juan Enrique López Monteagudo · jelopez.link</title>
  <meta name="description" content="Administrador de sistemas e infraestructura IT. Homelab, self-hosting y ciberseguridad." />
  <meta name="theme-color" content="#07070b" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&family=Syne:wght@600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <a href="#main" class="skip-link">Saltar al contenido</a>
  <div class="orbs" aria-hidden="true"><i></i><i></i><i></i><i></i></div>

  <nav>
    <ul class="nav-links">
      <li><a href="#sobre-mi">Sobre mí</a></li>
      <li><a href="#proyectos">Proyectos</a></li>
      <li class="nav-translate-desktop"><button id="translate-btn" class="translate-btn">EN</button></li>
    </ul>
  </nav>

  <main id="main">
  <div class="hero">
    <p class="hero-tag" id="hero-tag">SYSADMIN · HOMELAB · CIBERSEGURIDAD</p>
    <h1>JELOPEZ<span class="accent">.</span>LINK</h1>
    <p class="hero-sub" id="hero-sub">
      Administrador de sistemas e infraestructura IT.
      Hago self-hosting de todo lo que puedo y documento el proceso.
    </p>
    <div class="hero-buttons">
      <a href="https://github.com/Juanen47" target="_blank" class="btn btn-outline">GitHub</a>
      <a href="https://blog.jelopez.link" class="btn btn-outline">Blog</a>
      <a href="https://www.linkedin.com/in/juan-enrique-l%C3%B3pez-monteagudo-2063ab305/" target="_blank" class="btn btn-outline">LinkedIn</a>
    </div>
    <button id="translate-btn-mobile" class="translate-btn translate-btn-mobile">EN</button>
  </div>

  <section id="sobre-mi">
    <h2 class="section-title" id="about-title">Sobre mí</h2>
    <div class="about-text" id="about-text">
      Técnico Superior en Administración de Sistemas y Ciberseguridad. Trabajo en administración de sistemas e infraestructura IT, con entornos Windows y Linux, Azure/M365, MikroTik y SonicWall. Fuera del trabajo mantengo un homelab sobre un Intel NUC con Proxmox VE: servicios en contenedores LXC, acceso externo solo mediante Cloudflare Tunnel con MFA y monitorización propia. Lo experimento y lo documento todo en el blog.
      <a href="https://blog.jelopez.link/about">Más sobre mí →</a>
    </div>
    <div class="cards">
      <div class="card">
        <h3 id="card-1-title">Infraestructura</h3>
        <p id="card-1-text">Proxmox VE (Intel NUC), LXC, NPMplus, AdGuard Home, Homarr, Uptime Kuma y Netdata.</p>
      </div>
      <div class="card">
        <h3 id="card-2-title">Entornos</h3>
        <p id="card-2-text">Windows Server, Azure AD, M365, MikroTik, SonicWall, Linux.</p>
      </div>
      <div class="card">
        <h3 id="card-3-title">Scripting</h3>
        <p id="card-3-text">PowerShell, Bash, automatización y seguridad.</p>
      </div>
      <div class="card">
        <h3 id="card-4-title">Seguridad</h3>
        <p id="card-4-text">Cloudflare Tunnel sin puertos abiertos, Authelia (MFA), WireGuard VPN y auditorías de hardening con Lynis.</p>
      </div>
    </div>
  </section>

  <section id="proyectos">
    <h2 class="section-title" id="projects-title">Proyectos</h2>
    <div class="projects-grid">
      <a href="https://blog.jelopez.link" class="project-card">
        <div class="project-header">
          <h3>Homelab Blog</h3>
          <span class="tag">Blog · ES</span>
        </div>
        <p id="blog-desc">Documentación técnica del homelab: Proxmox, networking, servicios self-hosted, monitorización y hardening.</p>
      </a>
      <a href="/este-sitio" class="project-card">
        <div class="project-header">
          <h3 id="sitio-title">Este sitio</h3>
          <span class="tag">Astro · CF Pages</span>
        </div>
        <p id="sitio-desc">Stack, despliegue y decisiones de diseño detrás de jelopez.link.</p>
      </a>
    </div>
  </section>

  </main>

  <footer>
    <div class="footer-links">
      <a href="https://github.com/Juanen47" target="_blank">GitHub</a>
      <a href="mailto:juanenlopez1459@gmail.com">Email</a>
      <a href="https://www.linkedin.com/in/juan-enrique-l%C3%B3pez-monteagudo-2063ab305/" target="_blank">LinkedIn</a>
    </div>
    <p>© 2026 Juan Enrique López Monteagudo · jelopez.link</p>
  </footer>

</body>
</html>

<script>
  import '../scripts/glass.ts';
  const btnDesktop = document.getElementById('translate-btn') as HTMLButtonElement;
  const btnMobile = document.getElementById('translate-btn-mobile') as HTMLButtonElement;
  let translated = false;

  function setButtonState(text: string) {
    if (btnDesktop) btnDesktop.textContent = text;
    if (btnMobile) btnMobile.textContent = text;
  }

  const texts: Record<string, { es: string; en: string }> = {
    'hero-tag':       { es: 'SYSADMIN · HOMELAB · CIBERSEGURIDAD', en: 'SYSADMIN · HOMELAB · CYBERSECURITY' },
    'hero-sub':       { es: 'Administrador de sistemas e infraestructura IT. Hago self-hosting de todo lo que puedo y documento el proceso.', en: 'Systems administrator and IT infrastructure specialist. Self-hosting everything I can and documenting the journey.' },
    'about-title':    { es: 'Sobre mí', en: 'About' },
    'card-1-title':   { es: 'Infraestructura', en: 'Infrastructure' },
    'card-1-text':    { es: 'Proxmox VE (Intel NUC), LXC, NPMplus, AdGuard Home, Homarr, Uptime Kuma y Netdata.', en: 'Proxmox VE (Intel NUC), LXC, NPMplus, AdGuard Home, Homarr, Uptime Kuma y Netdata.' },
    'card-2-title':   { es: 'Entornos', en: 'Environments' },
    'card-2-text':    { es: 'Windows Server, Azure AD, M365, MikroTik, SonicWall, Linux.', en: 'Windows Server, Azure AD, M365, MikroTik, SonicWall, Linux.' },
    'card-3-title':   { es: 'Scripting', en: 'Scripting' },
    'card-3-text':    { es: 'PowerShell, Bash, automatización y seguridad.', en: 'PowerShell, Bash, automation and security.' },
    'card-4-title':   { es: 'Seguridad', en: 'Security' },
    'card-4-text':    { es: 'Cloudflare Tunnel sin puertos abiertos, Authelia (MFA), WireGuard VPN y auditorías de hardening con Lynis.', en: 'Cloudflare Tunnel with no open ports, Authelia (MFA), WireGuard VPN and hardening audits with Lynis.' },
    'projects-title': { es: 'Proyectos', en: 'Projects' },
    'blog-desc':      { es: 'Documentación técnica del homelab: Proxmox, networking, servicios self-hosted, monitorización y hardening.', en: 'Technical homelab documentation: Proxmox, networking, self-hosted services, monitoring and hardening.' },
    'sitio-title':    { es: 'Este sitio', en: 'This site' },
    'sitio-desc':     { es: 'Stack, despliegue y decisiones de diseño detrás de jelopez.link.', en: 'Stack, deployment and design decisions behind jelopez.link.' },
  };

  const aboutHTML: Record<string, string> = {
    es: `Técnico Superior en Administración de Sistemas y Ciberseguridad. Trabajo en administración de sistemas e infraestructura IT, con entornos Windows y Linux, Azure/M365, MikroTik y SonicWall. Fuera del trabajo mantengo un homelab sobre un Intel NUC con Proxmox VE: servicios en contenedores LXC, acceso externo solo mediante Cloudflare Tunnel con MFA y monitorización propia. Lo experimento y lo documento todo en el blog.
      <a href="https://blog.jelopez.link/about">Más sobre mí →</a>`,
    en: `Higher Technician in Systems Administration and Cybersecurity. I work in systems administration and IT infrastructure, with Windows and Linux environments, Azure/M365, MikroTik and SonicWall. Outside work I run a homelab on an Intel NUC with Proxmox VE: services in LXC containers, external access only through Cloudflare Tunnel with MFA, and my own monitoring. I experiment with it and document everything on the blog.
      <a href="https://blog.jelopez.link/about">More about me →</a>`,
  };

  const navLinks: Record<string, { es: string; en: string }> = {
    '#sobre-mi':  { es: 'Sobre mí', en: 'About' },
    '#proyectos': { es: 'Proyectos', en: 'Projects' },
  };

  function handleTranslate() {
    const lang = translated ? 'es' : 'en';

    Object.entries(texts).forEach(([id, { es, en }]) => {
      const el = document.getElementById(id);
      if (el) el.textContent = lang === 'en' ? en : es;
    });

    const aboutEl = document.getElementById('about-text');
    if (aboutEl) aboutEl.innerHTML = aboutHTML[lang];

    Object.entries(navLinks).forEach(([href, { es, en }]) => {
      const el = document.querySelector(`a[href="${href}"]`);
      if (el) el.textContent = lang === 'en' ? en : es;
    });

    setButtonState(translated ? 'EN' : 'ES');
    translated = !translated;
  }

  btnDesktop?.addEventListener('click', handleTranslate);
  btnMobile?.addEventListener('click', handleTranslate);
</script>

<style>
  .translate-btn-mobile {
    display: none;
    margin-top: 1.25rem;
  }

  .nav-links li { list-style: none; }

  @media (max-width: 640px) {
    .nav-translate-desktop { display: none; }
    .translate-btn-mobile { display: block; }
  }
</style>